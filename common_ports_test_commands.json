      "note": ""
    },
    {
      "port": "995",
      "name": "POP3S",
      "commands": [
        "openssl s_client -connect {IP}:995 -quiet"
      ],
      "note": ""
    },
    {
      "port": "1080",
      "name": "SOCKS",
      "commands": [
        "nmap --script socks-open-proxy -p 1080 {IP}",
