      ],
      "note": ""
    },
    {
      "port": "1194",
      "name": "OpenVPN",
      "commands": [
        "nmap -sV -p 1194 {IP}"
      ],
      "note": ""
    },
    {
      "port": "1352",
      "name": "Lotus Domino",
      "commands": [
        "nmap -p 1352 --script domino-enum-users {IP}"
      ],
      "note": ""
    },
    {
      "port": "1433",
      "name": "MSSQL",
      "commands": [
