      "note": "root 空密碼/弱密碼為高風險"
    },
    {
      "port": "3389",
      "name": "RDP",
      "commands": [
        "nmap --script ssl-enum-ciphers -p 3389 {IP}",
        "hydra -t 4 -L {USERLIST} -P {PASSWORDS} rdp://{IP}:3389",
        "hydra -t 4 -l administrator -P {PASSWORDS} rdp://{IP}:3389",
        "nmap --script rdp-ntlm-info -p 3389 {IP}",
        "hydra -t 4 -l {USER} -P {PASSWORDS} rdp://{IP}:3389",
