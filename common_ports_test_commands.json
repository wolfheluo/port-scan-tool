        "nmap -p 1433 --script ms-sql-info,ms-sql-empty-password {IP}",
        "msf6> use auxiliary/scanner/mssql/mssql_login",
        "impacket-mssqlclient.py sa:{PASSWORD}@{IP}",
        "sqsh -S {IP} -U sa"
      ],
      "note": "sa 空密碼/弱密碼為高風險"
    },
    {
      "port": "1521",
      "name": "Oracle",
      "commands": [
        "msf6> use auxiliary/scanner/oracle/sid_enum",
        "nmap -p 1521 --script oracle-sid-brute {IP}",
        "odat.py all -s {IP} -p 1521"
      ],
      "note": ""
    },
    {
      "port": "1723",
      "name": "PPTP",
      "commands": [
        "thc-pptp-bruter -u {USER} -w {PASSWORDS} {IP}",
        "nmap -sV -p 1723 --script pptp-version {IP}"
      ],
      "note": ""
    },
    {
      "port": "1883",
      "name": "MQTT",
      "commands": [
        "nmap -p 1883 --script mqtt-subscribe {IP}"
