{
  "variables": [
    "IP",
    "PORT",
    "DOMAIN",
    "USER",
    "PASSWORD",
    "USERLIST",
    "PASSWORDS",
    "PATH"
  ],
  "usage": "每個 command 字串可用 .format(IP=..., PORT=..., ...) 展開; msf6> 前綴為 Metasploit 指令",
  "ports": [
    {
      "port": "21",
      "name": "FTP",
      "commands": [
        "hydra -L {USERLIST} -P {PASSWORDS} ftp://{IP} -t 3 -v",
        "nmap -sV -p 21 --script ftp-anon {IP}"
      ],
      "note": "FTP匿名登入測試：使用者名稱輸入「anonymous」，密碼不用提供(直接按enter)，若登入成功代表允許匿名登入，可用ls列舉檔案並截圖。"
    },
    {
      "port": "22",
      "name": "SSH",
      "commands": [
        "hydra -v -V -u -l root -P {PASSWORDS} -t 1 {IP} ssh",
        "nmap -sV -p 22 --script ssh2-enum-algos {IP}",
        "msf6> use auxiliary/scanner/ssh/ssh_login",
        "nmap -sV -p 22 --script ssh2-enum-algos,ssh-auth-methods {IP}"
      ],
      "note": ""
    },
    {
      "port": "23",
      "name": "Telnet",
      "commands": [
        "nc -nv {IP} 23",
        "nmap -sV -p 23 --script telnet-encryption {IP}",
        "hydra -L {USERLIST} -P {PASSWORDS} telnet://{IP}"
      ],
      "note": ""
    },
    {
      "port": "25",
      "name": "SMTP",
      "commands": [
        "nmap -p25 --script smtp-commands {IP}",
        "nmap --script=smtp-commands,smtp-enum-users,smtp-vuln-cve2010-4344,smtp-vuln-cve2011-1720,smtp-vuln-cve2011-1764 -p 25 {IP}",
        "nc -nvc {IP}",
        "msf6> use auxiliary/scanner/smtp/smtp_enum",
        "smtp-user-enum -M VRFY -U {USERLIST} -t {IP}",
        "nmap -p25 --script smtp-commands,smtp-enum-users {IP}",
        "nc -nvc {IP} 25",
        "swaks --to test@{DOMAIN} --server {IP}"
      ],
      "note": ""
    },
    {
      "port": "53",
      "name": "DNS",
      "commands": [
        "dnsrecon -d {IP} -a",
        "nmap --script dns-nsid {IP} -p 53",
        "dnsrecon -d {DOMAIN} -a",
        "dig AXFR @{IP} {DOMAIN}",
        "nmap -sU -p 53 --script dns-recursion {IP}"
      ],
      "note": ""
    },
    {
      "port": "69",
      "name": "TFTP",
      "commands": [
        "nmap -sU -p 69 --script tftp-enum {IP}",
        "tftp {IP} 69"
      ],
      "note": "TFTP 通常無認證, 可嘗試下載設定檔"
    },
    {
      "port": "80",
      "name": "HTTP",
      "commands": [
        "nmap --script http-title,http-headers,http-methods -p 80,443 {IP}",
        "curl -I http://{IP}:80"
      ],
      "note": ""
    },
    {
      "port": "80,443",
      "name": "HTTP/HTTPS",
      "commands": [
        "nmap --script http-aspnet-debug --script-args http-aspnet-debug.path=/path {IP} -p 443",
        "nmap --script http-aspnet-debug --script-args http-aspnet-debug.path={PATH} {IP} -p 443",
        "nmap --script http-title,http-headers,http-methods -p 80,443 {IP}"
      ],
      "note": ""
    },
    {
      "port": "88",
      "name": "Kerberos",
      "commands": [
        "nmap -sV -p 88 --script krb5-enum-users --script-args krb5-enum-users.realm={DOMAIN} {IP}",
        "impacket-GetNPUsers.py {DOMAIN}/ -usersfile {USERLIST} -dc-ip {IP} -no-pass"
      ],
      "note": ""
    },
    {
      "port": "110",
      "name": "POP3",
      "commands": [
        "nc -ncv {IP} {PORT}",
        "msf6> use auxiliary/sanner/pop3/pop3_login",
        "nc -nv {IP} 110",
        "hydra -L {USERLIST} -P {PASSWORDS} pop3://{IP}",
        "msf6> use auxiliary/scanner/pop3/pop3_login"
      ],
      "note": ""
    },
    {
      "port": "111",
      "name": "RPC portmapper",
      "commands": [
        "rpcclient -U \"\" -N {IP}",
        "impacket-rpcdump.py {USER}:{PASSWORD}@{IP}",
        "nmap -sV -p 111 --script rpcinfo {IP}"
      ],
      "note": "含 RPC PORT 檢查; 若 111+2049 皆開, 續測 NFS"
    },
    {
      "port": "123",
      "name": "NTP",
      "commands": [
        "nmap -sU -p 123 --script ntp-monlist {IP}",
        "ntpq -c version {IP}"
      ],
      "note": ""
    },
    {
      "port": "135",
      "name": "MSRPC",
      "commands": [
        "nmap --script=msrpc-enum {IP}",
        "msf6>use auxiliary/scanner/dcerpc/management",
        "msf6>use auxiliary/scanner/dcerpc/hidden",
        "msf6> use auxiliary/scanner/dcerpc/management",
        "msf6> use auxiliary/scanner/dcerpc/hidden"
      ],
      "note": ""
    },
    {
      "port": "139",
      "name": "NetBIOS-SSN",
      "commands": [
        "nbtscan-unixwiz -n {IP}",
        "nbtscan -n {IP}",
        "nmap -sU -p 137 --script nbstat {IP}",
        "nmblookup -A {IP}",
        "smbclient -N -L //{IP}"
      ],
      "note": ""
    },
    {
      "port": "161",
      "name": "SNMP",
      "commands": [
        "nmap -sU -p 161 --script snmp-info,snmp-brute {IP}",
        "snmp-check {IP}",
        "onesixtyone -c dict.txt {IP}",
        "snmpwalk -v2c -c public {IP}"
      ],
      "note": "public/private 社群字串為常見弱點"
    },
    {
      "port": "179",
      "name": "BGP",
      "commands": [
        "nmap -sV -p 179 {IP}"
      ],
      "note": ""
    },
    {
      "port": "389",
      "name": "LDAP",
      "commands": [
        "nmap -p 389 --script ldap-rootdse {IP}",
        "ldapsearch -x -H ldap://{IP} -b \"\" -s base namingContexts",
        "ldapsearch -x -H ldap://{IP} -b \"dc=example,dc=com\""
      ],
      "note": ""
    },
    {
      "port": "443",
      "name": "HTTPS",
      "commands": [
        "sslscan {IP}or{IP}:{PORT}",
        "nmap -p 443,8443 -Pn --script ssl-cert  {IP} ->SSL憑證資訊",
        "nmap -sV --script ssl-enum-ciphers -p 443 {IP}",
        "sslscan {IP} 或 sslscan {IP}:{PORT}",
        "nmap -p 443,8443 -Pn --script ssl-cert {IP}",
        "openssl s_client -connect {IP}:443 -servername {DOMAIN}",
        "testssl.sh {IP}:443"
      ],
      "note": ""
    },
    {
      "port": "445",
      "name": "SMB",
      "commands": [
        "nmap --script smb-os-discovery,smb-protocols {IP}",
        "smbclient -N -L //{IP}",
        "smbmap -H {IP}",
        "nmap --script smb-vuln-ms17-010 -p 445 {IP}",
        "crackmapexec smb {IP}",
        "enum4linux -a {IP}"
      ],
      "note": "關於第1項，經3次循環實測，若使用smb-os-discovery,smb-protocols，可能會偵測不到「NT LM 0.12 (SMBv1) [dangerous, but default]」，原因未知，可考慮單獨執行smb-protocols。"
    },
    {
      "port": "500",
      "name": "ISAKMP",
      "commands": [
        "ike-scan {IP}"
      ],
      "note": "VPN IKE 掃描, 可續用 ike-scan --showbackoff 判斷 PSK"
    },
    {
      "port": "512",
      "name": "rexec",
      "commands": [
        "nc -nv {IP} 512",
        "rusers -l {IP}"
      ],
      "note": "舊版遠端執行/使用者列舉"
    },
    {
      "port": "513",
      "name": "rlogin",
      "commands": [
        "nc -nv {IP} 513",
        "rlogin -l root {IP}"
      ],
      "note": ""
    },
    {
      "port": "514",
      "name": "syslog/rsh",
      "commands": [
        "nc -nv {IP} 514"
      ],
      "note": ""
    },
    {
      "port": "515",
      "name": "LPD",
      "commands": [
        "nmap -p 515 --script lpd-info {IP}"
      ],
      "note": "印表機 daemon"
    },
    {
      "port": "548",
      "name": "AFP",
      "commands": [
        "nmap -sV -p 548 --script afp-serverinfo {IP}"
      ],
      "note": "macOS 檔案分享"
    },
    {
      "port": "623",
      "name": "IPMI",
      "commands": [
        "nmap -sU -p 623 --script ipmi-version {IP}",
