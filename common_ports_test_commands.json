    },
    {
      "port": "2181",
      "name": "ZooKeeper",
      "commands": [
        "nmap --script zookeeper-info -p 2181 {IP}",
        "echo envi | nc {IP} 2181"
      ],
      "note": ""
    },
    {
      "port": "2375",
      "name": "Docker API",
      "commands": [
        "curl http://{IP}:2375/version",
        "curl http://{IP}:2375/containers/json",
        "nmap --script docker-version -p 2375 {IP}"
      ],
      "note": "未授權 Docker API = 直接 RCE (掛載 / 即可拿 host)"
