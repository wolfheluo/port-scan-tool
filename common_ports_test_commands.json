      ],
      "note": ""
    },
    {
      "port": "873",
      "name": "rsync",
      "commands": [
        "nmap --script rsync-list-modules -p 873 {IP}",
        "rsync -av --list-only rsync://{IP}/"
      ],
      "note": "列出模組後可嘗試無帳號下載 rsync://{IP}/{模組}"
    },
    {
      "port": "993",
      "name": "IMAPS",
      "commands": [
        "openssl s_client -connect {IP}:993 -quiet",
