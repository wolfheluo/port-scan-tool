      "note": "IPMI 2.0 預設 admin/admin; 注意 CVE-2013-4786 雜湊擷取"
    },
    {
      "port": "636",
      "name": "LDAPS",
      "commands": [
        "ldapsearch -x -H ldaps://{IP} -b \"\" -s base namingContexts",
